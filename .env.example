# Copy to .env.local and fill in. NEVER commit .env.local or real keys.
# On Vercel: Project -> Settings -> Environment Variables.

# ---------- Firebase (browser config; not secret, but project specific) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---------- Firebase Admin (SERVER ONLY, secret) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Server secrets (32+ random characters each) ----------
ROUTINE_RUNNER_SECRET=
GUMROAD_PING_SECRET=

# ---------- Billing (only on the official hosted service) ----------
# GUMROAD_LINKS={"pro":"https://you.gumroad.com/l/agv-pro","plus":"...","max":"...","max2x":"...","ultra":"..."}
# GUMROAD_PRODUCT_MAP={"agv-pro":"pro"}
GUMROAD_ACCESS_TOKEN=

# ---------- Optional tools ----------
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
PEXELS_API_KEY=

# ---------- FOUNT (optional) ----------
FOUNT_ENABLED=0
NEXT_PUBLIC_FOUNT=0
FOUNT_ADMINS=

# ---------- Testing only: NEVER set on a public deployment ----------
# VENUS_UNLIMITED_TEST_MODE=true
# VENUS_UNLIMITED_TEST_UIDS=uid1,uid2
# ALLOW_INSECURE_DEV=1