rules_version = '2';

// AgenticVenus Firestore rules.
// The BROWSER may only touch the user's own working data. Everything that decides money or limits
// (plan, usage, payments, vault, audit) is written ONLY by the server (Admin SDK bypasses these rules).
// Anything not listed here is denied. Deploy: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The browser may read its user document and write exactly ONE field: pcSandboxId.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['pcSandboxId']);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pcSandboxId']);
      allow delete: if false;
    }

    match /users/{uid}/chats/{document=**}         { allow read, write: if isOwner(uid); }
    match /users/{uid}/teams/{document=**}         { allow read, write: if isOwner(uid); }
    match /users/{uid}/pcJobs/{document=**}        { allow read, write: if isOwner(uid); }
    match /users/{uid}/routines/{document=**}      { allow read, write: if isOwner(uid); }
    match /users/{uid}/recipes/{document=**}       { allow read, write: if isOwner(uid); }
    match /users/{uid}/codeProjects/{document=**}  { allow read, write: if isOwner(uid); }
    match /users/{uid}/venusProjects/{document=**} { allow read, write: if isOwner(uid); }
    match /users/{uid}/venusStudio/{document=**}   { allow read, write: if isOwner(uid); }
    match /users/{uid}/traces/{document=**}        { allow read, write: if isOwner(uid); }
    match /users/{uid}/agents/{document=**}        { allow read, write: if isOwner(uid); }

    // NOT listed on purpose (server only): users/{uid}/billing/*, vault, vpass, vpay, audit,
    // billingIndex, billingEvents, billingUnclaimed, and every other collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}